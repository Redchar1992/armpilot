{
  "name": "armpilot-frontend",
  "private": true,
  "type": "module",
  "description": "Interactive browser workspace for language-grounded robot manipulation.",
  "license": "MIT",
  "homepage": "https://redchar1992.github.io/armpilot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Redchar1992/armpilot.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "preview:static": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:all": "npm run check && playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.1.2",
    "@react-three/fiber": "^9.1.2",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/three": "^0.177.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
